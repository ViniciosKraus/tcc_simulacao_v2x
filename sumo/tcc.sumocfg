<configuration>
    <input>
        <net-file value="ifsc_map.net.xml"/>
        <route-files value="tcc_scenario.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="200"/>
        <step-length value="0.1"/>
    </time>

    <processing>
        <ignore-junction-blocker value="20"/>
        <time-to-teleport value="-1"/>
    </processing>

    <gui_only>
        <start value="false"/>
        <delay value="250"/>
    </gui_only>
</configuration>
