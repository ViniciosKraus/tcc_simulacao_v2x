<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="ifsc_map.net.xml"/>
        <route-files value="tcc_cenario_desvio.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="300"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
    </processing>
    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
